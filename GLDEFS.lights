// ------------------------------------------------------
// ------------------ DOOM GAME LIGHTS ------------------
// ------------------------------------------------------

// ----------------------
// -- Doom Decorations --
// ----------------------

// Floor lamp
pointlight LAMP
{
    color 1.0 0.8 0.1
    size 64
    offset 0 44 0
}

object Column
{
    frame COLU { light LAMP }
}

// Short tech lamp
pulselight SMALLLAMP
{
    color 1.0 0.7 0.0
    size 48
    secondarySize 64
    interval 2.0
    offset 0 44 0
}

object TechLamp2
{
    frame TLP2 { light SMALLLAMP }
}

// Tall tech lamp
pulselight BIGLAMP
{
    color 1.0 0.7 0.0
    size 64
    secondarySize 82
    interval 2.0
    offset 0 72 0
}

object TechLamp
{
    frame TLMP { light BIGLAMP }
}

// Skulls w/candles
flickerlight2 SKULLCANDLES
{
    color 1.0 0.5 0.0
    size 36
    secondarySize 48
    interval 0.2
    offset 0 48 0
}

object HeadCandles
{
    frame POL3 { light SKULLCANDLES }
}

// Candle Flame
flickerlight2 CANDLE
{
    color 0.4 0.1 0.8
    size 20
    secondarySize 32
    interval 0.1
    offset 0 3 0
}