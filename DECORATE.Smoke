ACTOR DDS_FloorSmoke : DDS_StillSmoke
{
  -ForceXYBillboard
  +FLATSPRITE 
}


ACTOR DDS_BlackStillSmoke : DDS_StillSmoke
{
  StencilColor "Black"
}

ACTOR DDS_BlackFloorSmoke : DDS_BlackStillSmoke
{
  -ForceXYBillboard
  +FLATSPRITE 
}

ACTOR DDS_RedStillSmoke : DDS_StillSmoke
{
  StencilColor "DarkRed"
  RenderStyle "AddShaded"
}

ACTOR DDS_RedFloorSmoke : DDS_RedStillSmoke
{
  -ForceXYBillboard
  +FLATSPRITE 
}

