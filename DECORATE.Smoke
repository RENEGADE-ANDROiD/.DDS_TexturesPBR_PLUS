  +FLATSPRITE 
}

ACTOR DDS_FoggySmokeSpawner
{
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOBLOCKMAP
	+NOGRAVITY
	+NOTELEPORT
	+FORCEXYBILLBOARD
	Radius 0
	Height 0
	States
	{
    Spawn:
	    TNT1 A 0
		TNT1 A 1 A_CheckRange(750,8)
		TNT1 A 12 A_SpawnItemEx("DDS_FloorSmoke", random(-88, 88), random(-88, 88), random(1, 12), 0.01*random(-30, 30), 0.01*random(-30, 30), 0)
		TNT1 A 12
		TNT1 A 12 A_SpawnItemEx("DDS_StillSmoke", random(-88, 88), random(-88, 88), random(-88, 33), 0.01*random(-30, 30), 0.01*random(-30, 30), 0)
		TNT1 A 12
		TNT1 A 12 A_SpawnItemEx("DDS_FloorSmoke", random(-164, 164), random(-164, 164), random(1, 13), 0, 0, 0)
		TNT1 A 12
		TNT1 A 12 A_SpawnItemEx("DDS_StillSmoke", random(-164, 164), random(-164, 164), random(-88, 88), 0, 0, 0.01*random(-40, 40))
		TNT1 A 12
		TNT1 A 1
		Loop
	}
}

