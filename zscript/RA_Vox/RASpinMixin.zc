//===========================================================================
//
// DDSRASpinMixin
// Re-usable spinner mixin.
//
//===========================================================================

mixin class DDSRASpinMixin
{
	void A_DDSSpin(Actor mo)
	{
		if (!mo)
			return;

		mo.A_SetAngle(mo.Angle + 3.33, SPF_INTERPOLATE);
	}
}
