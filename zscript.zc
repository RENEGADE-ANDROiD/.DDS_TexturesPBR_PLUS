		+NOTRIGGER
		+THRUACTORS
		+EXPLODEONWATER
		+NOCLIP
		-NOGRAVITY
		-NOINTERACTION
		-SKYEXPLODE
		-BRIGHT
		Renderstyle "translucent";
		Speed 3;
		Damage 0;
		Alpha 0.92;
		Scale 0.92;
		Mass 2;
		Gravity 0.91;
	}
	States
	{
		Spawn:
			LQP0 A 0 NoDelay;
			LQP0 AAAAA 1;
			LQP0 AAAAA 1 A_FadeOut(0.2);
			Stop;
		Crash:
			LQP0 BCD 1;
			Stop;
		Death:
			LQP0 BCD 1;
			Stop;
	}
}


