			}
		}
		Goto Spawn;
	Mute:
		TNT1 A 0 {
			A_StopSound(6);
			A_StopSound(7);
		}
		Goto Spawn;
	}
}

class PreSpawner : RainBase
{
	Vector2 spawnSpot;
	int ceilingHeight;
	int floorHeight;
	int spawned;

	default{
		Radius 1;
		Height 1;
		+NoClip;
		+ClientSideOnly;
		+SpawnCeiling;
		+NoGravity;
	}

	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 0 A_JumpIf(!self.CurSector,"Nothing");
		TNT1 A 0 {
			spawnSpot = self.Vec2Offset(self.pos.x, self.pos.y);
			ceilingHeight = self.curSector.ceilingplane.ZatPoint(spawnSpot);
			floorHeight = self.curSector.floorplane.ZatPoint(spawnSpot);
		}
		TNT1 A 1 {
			if(CVar.FindCVar("weathermode").GetInt() == 0 || (CVar.FindCVar("weathermode").GetInt() >= 3 && CVar.FindCVar("weatheractive").GetInt() == 0)){
				A_SpawnItemEx("RainDrop", 0, 0, (ceilingHeight-self.pos.z)-2, 0, 0, frandom(-2,-9), 0 , 128, 0);
			}else if(CVar.FindCVar("weathermode").GetInt() == 1 || (CVar.FindCVar("weathermode").GetInt() >= 3 && CVar.FindCVar("weatheractive").GetInt() == 1)){
				if(CVar.FindCVar("windchange").GetInt() <= 10000){
					A_SpawnItemEx("SnowBallRR", 0, 0, frandom((ceilingHeight-self.pos.z)-2,(ceilingz-floorz)*-1), random(2,8), -4, random(-2,0), 0 , 128, 0);
				}else{
					A_SpawnItemEx("SnowBallRR", 0, 0, frandom((ceilingHeight-self.pos.z)-2,(ceilingz-floorz)*-1), random(-2,-8), 4, random(-2,0), 0 , 128, 0);
				}
			}else if(CVar.FindCVar("weathermode").GetInt() == 2 || (CVar.FindCVar("weathermode").GetInt() >= 3 && CVar.FindCVar("weatheractive").GetInt() == 2)){
				if(CVar.FindCVar("windchange").GetInt() <= 10000){
					A_SpawnItemEx("AshesRR", 0, 0, frandom((ceilingHeight-self.pos.z)-2,(ceilingz-floorz)*-1), random(1,4), -2, random(-1,0), 0 , 128, 0);
				}else{
					A_SpawnItemEx("AshesRR", 0, 0, frandom((ceilingHeight-self.pos.z)-2,(ceilingz-floorz)*-1), random(-1,-4), 2, random(-1,0), 0 , 128, 0);
				}
			}
		}
		Goto Nothing;
	}
}

class RainDrop : RainBase
{
	Vector2 spawnSpot;
	Vector3 x;
	bool skyCheck;
	double ceilz;
	actor player;

	default {
		+Missile;
		+NoBlockMap;
		+DONTSPLASH;
		-NoGravity;
		-FLOORCLIP;
		Height 2;
		Radius 2;
		Renderstyle "Translucent";
		Alpha 0.0;
		Scale 0.25;
		VSpeed -69;	
		+FORCEYBILLBOARD;
		+VULNERABLE;
	}

	override void Tick() {
		super.Tick();

		if(WaterLevel > 0){
			alpha = 0.0;
			A_Die();
		}

    }

	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 0
		{
			self.player = players[consoleplayer].mo;
			spawnSpot = self.Vec2Offset(self.pos.x, self.pos.y);
			[skyCheck, ceilz] = CheckSky(self.CurSector, spawnSpot, self.curSector.ceilingplane.ZatPoint(spawnSpot));
		}
		TNT1 A 0 A_JumpIf(!skyCheck,"Nothing");
		//TNT1 A 0 A_CheckSight("Nothing");
		TNT1 A 0 A_CheckRange(1024,"Nothing",1);
		TNT1 A 0 {
			if(random(1,1000) > 999){
				if(random(1,100) > 50){
					A_SpawnItemEx("HexenLeaves", 0, 0, 0, random(1,4), -2, random(-1,1), 0 , 128, 0);
				}else{
					A_SpawnItemEx("HexenLeaves", 0, 0, 0, random(-1,-4), 2, random(-1,1), 0 , 128, 0);
				}
			}
		}
		TNT1 A 0
		{
			bSPRITEFLIP = random(0,1);

			if(CVar.FindCVar("raincolor").GetInt() == 0 || (CVar.FindCVar("raincolor").GetInt() >= 7 && CVar.FindCVar("raincoloractive").GetInt() == 0)){
				A_SetTranslation("NormalRain");
			}
			if(CVar.FindCVar("raincolor").GetInt() == 1 || (CVar.FindCVar("raincolor").GetInt() >= 7 && CVar.FindCVar("raincoloractive").GetInt() == 1)){
				A_SetTranslation("RedRain");
			}
			if(CVar.FindCVar("raincolor").GetInt() == 2 || (CVar.FindCVar("raincolor").GetInt() >= 7 && CVar.FindCVar("raincoloractive").GetInt() == 2)){
				A_SetTranslation("GreenRain");			
			}
			if(CVar.FindCVar("raincolor").GetInt() == 3 || (CVar.FindCVar("raincolor").GetInt() >= 7 && CVar.FindCVar("raincoloractive").GetInt() == 3)){
				A_SetTranslation("BlueRain");				
			}
			if(CVar.FindCVar("raincolor").GetInt() == 4 || (CVar.FindCVar("raincolor").GetInt() >= 7 && CVar.FindCVar("raincoloractive").GetInt() == 4)){
				A_SetTranslation("BlackRain");
			}
			if(CVar.FindCVar("raincolor").GetInt() == 5 || (CVar.FindCVar("raincolor").GetInt() >= 7 && CVar.FindCVar("raincoloractive").GetInt() == 5)){
				A_SetTranslation("PurpleRain");
			}
			if(CVar.FindCVar("raincolor").GetInt() == 6 || (CVar.FindCVar("raincolor").GetInt() >= 7 && CVar.FindCVar("raincoloractive").GetInt() == 6)){
				if(random(0,1) == 0){
					A_SetTranslation("RedRain");
				}else{
					A_SetTranslation("BlueRain");
				}
			}

			alpha = frandom(0.0,0.3);

			scale.y = frandom(0.01,0.05);
			scale.x = frandom(0.15,0.25);
		}
		RAIN A 3;
		TNT1 A 0{
			scale.y = frandom(0.05,1.5);
		}
		RAIN A 6 A_FadeIn(0.05);
		TNT1 A 0{
			scale.y = frandom(0.05,2.5);
		}
		RAIN A 9 A_FadeIn(0.05);
		Goto RainLoop;
	RainLoop:
		RAIN A 6;
		Loop;
	Death:
		RAIN A 1;
		TNT1 A 0
		{
			if(!skyCheck){
				return;
			}
			if(self.CurSector.PlaneMoving(Sector.floor)){
				return;
			}
			String s = TexMan.GetName(self.curSector.GetTexture(Sector.floor));
			let t = GetFloorTerrain();
			if (t.IsLiquid && pos.z <= floorz)
			{
				if(self.curSector.GetHeightSec()){
					A_SpawnItemEx("RainSplash", 0, 0, abs(pos.z-self.curSector.GetHeightSec().floorplane.ZatPoint(spawnSpot)), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, abs(pos.z-self.curSector.GetHeightSec().floorplane.ZatPoint(spawnSpot)), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, abs(pos.z-self.curSector.GetHeightSec().floorplane.ZatPoint(spawnSpot)), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, abs(pos.z-self.curSector.GetHeightSec().floorplane.ZatPoint(spawnSpot)), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);

				}else{
					A_SpawnItemEx("RainSplash", 0, 0, abs(pos.z-floorz), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, abs(pos.z-floorz), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, abs(pos.z-floorz), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, abs(pos.z-floorz), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
				}
			}else if(s.Mid(0, s.Length()-1) == "NUKAGE" || s.Mid(0, s.Length()-1) == "FWATER" ||
				s.Mid(0, s.Length()-1) == "SWATER" || s.Mid(0, s.Length()-1) == "LAVA" || 
					s.Mid(0, s.Length()-1) == "BLOOD" || (s.Mid(0, s.Length()-2) == "SLIME" && s.Mid(5,2).ToInt(10) < 9) ||
						s.Mid(0,s.Length()-1) == "FLTWAWA" || s.Mid(0,s.Length()-1) == "FLTFLWW" || s.Mid(0,s.Length()-1) == "FLTLAVA" ||
							s.Mid(0,s.Length()-1) == "FLTHUH" || s.Mid(0,s.Length()-1) == "FLTSLUD" || (s.Mid(0, s.Length()-2) == "X_0" && s.Mid(3,2).ToInt(10) < 12) ||
								s.Mid(2,s.Length()-2) == "WATR" || s.Mid(3,s.Length()-1) == "WATR" || s.Mid(1,s.Length()-2) == "LAVA" || s.Mid(1,s.Length()-2) == "BLOOD" || s.Mid(1,s.Length()-1) == "BLOOD" ||
									s.Mid(1,s.Length()-3) == "LQ"){
				if(WaterLevel > 0 && self.curSector.GetHeightSec()){
					A_SpawnItemEx("RainSplash", 0, 0, abs(pos.z-self.curSector.GetHeightSec().floorplane.ZatPoint(spawnSpot)), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, abs(pos.z-self.curSector.GetHeightSec().floorplane.ZatPoint(spawnSpot)), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, abs(pos.z-self.curSector.GetHeightSec().floorplane.ZatPoint(spawnSpot)), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, abs(pos.z-self.curSector.GetHeightSec().floorplane.ZatPoint(spawnSpot)), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
				}else{
					A_SpawnItemEx("RainSplash", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
				}
			}else{
				if(WaterLevel > 0 && self.curSector.GetHeightSec()){
					A_SpawnItemEx("RainSplash", 0, 0, abs(pos.z-self.curSector.GetHeightSec().floorplane.ZatPoint(spawnSpot)), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, abs(pos.z-self.curSector.GetHeightSec().floorplane.ZatPoint(spawnSpot)), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, abs(pos.z-self.curSector.GetHeightSec().floorplane.ZatPoint(spawnSpot)), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, abs(pos.z-self.curSector.GetHeightSec().floorplane.ZatPoint(spawnSpot)), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
				}else if(WaterLevel > 0){
					A_SpawnItemEx("RainSplash", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
					A_SpawnItemEx("RainRipple", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERTRANSLATION);
				}
			}
		}
		TNT1 A 0 {
			scale = (0.2,0.2);
			bForceYBillboard = false;
			bForceXYBillboard = true;
		}
		RAIN BCDE 1 {
			if(skyCheck){
				A_FadeIn(0.1);
			}
		}
		Goto Nothing;
	}
}

class RainSplash : RainBase
{
	Vector3 x;
	
	default {
		+NoBlockMap;
		+DONTSPLASH;
		+NoGravity;
		-FLOORCLIP;
		Height 0;
		Radius 0;
		Renderstyle "Translucent";
		Alpha 0.2;
		Scale 0.25;
		+FORCEYBILLBOARD;
	}

	override void Tick() {
		super.Tick();

		if(WaterLevel > 0){
			//alpha = 0.0;
			x = (self.pos.x,self.pos.y,self.pos.z+1);
			SetOrigin(x,false);
		}

	}

	States
	{
	Spawn:
		TNT1 A 0
		{
			bSPRITEFLIP = random(0,1);
			alpha = frandom(0.2,0.5);
			scale = (0.2,0.2);
			bForceYBillboard = false;
			bForceXYBillboard = true;
		}
		RAIN BCDE 1 A_FadeIn(0.1);
		Goto Nothing;
	}
}

class RainRipple : RainBase
{
	Vector3 x;
	double z;

	default {
		+NoBlockMap;
		+DONTSPLASH;
		+NoGravity;
		-FLOORCLIP;
		Height 0;
		Radius 0;
		Renderstyle "Translucent";
		Alpha 0.3;
		Scale 0.1;
		+FORCEYBILLBOARD;
	}

	override void Tick() {
		super.Tick();

		if(WaterLevel > 0){
			alpha = 0.0;
			x = (self.pos.x,self.pos.y,self.pos.z+1);
			SetOrigin(x,false);
		}

	}

	States
	{
	Spawn:
		TNT1 A 0
		{
			bSPRITEFLIP = random(0,1);
			alpha = 0.3;
			z = frandom(0.05,0.1);
			scale = (z,z);
			bForceYBillboard = false;
			bForceXYBillboard = true;
		}
		RIPL A 3 A_FadeOut(0.01);
		TNT1 A 0 {
			alpha = 0.3;
			z = frandom(0.1,0.15);
			scale = (z,z);
		}
		RIPL A 3 A_FadeOut(0.02);
		TNT1 A 0 {
			alpha = 0.3;
			z = frandom(0.15,0.20);
			scale = (z,z);
		}
		RIPL A 3 A_FadeOut(0.03);
		Goto Nothing;
	}
}

class SnowBallRR : RainBase
{
	Vector2 spawnSpot;
	bool skyCheck;
	double ceilz;
	actor player;
	double x;

	default {
		+Missile;
		+NoBlockMap;
		+DONTSPLASH;
		+NoGravity;
		-FLOORCLIP;
		+NOTELEPORT
		+THRUACTORS
		BounceType "Heretic";
		Height 2;
		Radius 2;
		Renderstyle "Translucent";
		Alpha 0.0;
		Scale 0.25;
		//VSpeed -69;	
		+FORCEYBILLBOARD;
		+VULNERABLE;
	}

	override void Tick() {
		super.Tick();

		if(WaterLevel > 0){
			alpha = 0.0;
			A_Die();
		}

		if(self.pos.z == self.curSector.floorplane.ZatPoint(self.Vec2Offset(self.pos.x, self.pos.y))){
			A_Stop();
		}
    }

	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 0
		{
			self.player = players[consoleplayer].mo;
			spawnSpot = self.Vec2Offset(self.pos.x, self.pos.y);
			[skyCheck, ceilz] = CheckSky(self.CurSector, spawnSpot, self.curSector.ceilingplane.ZatPoint(spawnSpot));
		}
		TNT1 A 0 A_JumpIf(!skyCheck,"Nothing");
		TNT1 A 0 A_CheckSight("Nothing");
		TNT1 A 0 A_CheckRange(512,"Nothing",0);
		TNT1 A 0 {
			if(random(1,100) < 69){
				if(CVar.FindCVar("windchange").GetInt() <= 10000){
					A_SpawnItemEx("LittleWhiteCloud", 0, 0, 0, random(1,4), -2, random(-1,0), 0 , 128, 0);
				}else{
					A_SpawnItemEx("LittleWhiteCloud", 0, 0, 0, random(-1,-4), 2, random(-1,0), 0 , 128, 0);
				}
			}
			if(random(1,1000) > 999){
				if(CVar.FindCVar("windchange").GetInt() <= 10000){
					A_SpawnItemEx("HexenLeaves", 0, 0, 0, random(1,4), -2, random(-1,1), 0 , 128, 0);
				}else{
					A_SpawnItemEx("HexenLeaves", 0, 0, 0, random(-1,-4), 2, random(-1,1), 0 , 128, 0);
				}
			}
		}
		TNT1 A 0
		{
			bSPRITEFLIP = random(0,1);
			//alpha = frandom(0.1,0.5);
			x = frandom(0.1,0.3);
			scale = (x,x);
		}
		SNOW A 3 A_FadeIn(0.1);
		SNOW A 6 A_FadeIn(0.2);
		SNOW A 9 A_FadeIn(0.3);
		TNT1 A 0 A_CheckSight("Nothing");
		TNT1 A 0 A_CheckRange(512,"Nothing",0);
		Goto Loopy;
	Loopy:
		SNOW A 6;
		TNT1 A 0 A_CheckSight("Nothing");
		TNT1 A 0 A_CheckRange(512,"Nothing",0);
		TNT1 A 0 A_Jump(32,"Death");
		TNT1 A 0 A_Jump(32,"SpiralLoop");
		Loop;
	SpiralLoop:
		TNT1 A 0 A_CheckSight("Nothing");
		TNT1 A 0 A_CheckRange(512,"Nothing",0);
		SNOW A 1 A_SetAngle(angle+random(10,30));
		SNOW A 1 A_ChangeVelocity (random(1.0,2.0), 0.0, -0.5, CVF_RELATIVE|CVF_REPLACE);
		TNT1 A 0 A_Jump(16,"Death");
		Loop;
	Death:
		SNOW A 9 {
			A_FadeOut(0.3);
			scale = (self.scale.x-0.05,self.scale.y-0.05);
		}
		Goto Nothing;
	}
}

