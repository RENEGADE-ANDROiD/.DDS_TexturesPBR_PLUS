		TNT1 A 0 A_Jump(128,"Spawn2");
		LFH1 ABC 4;
		LFH1 D 4 A_FadeIn(0.1);
		LFH1 EFG 4;
		LFH1 H 4 A_FadeIn(0.2);
		LFH1 IAB 4;
		LFH1 C 4 A_FadeIn(0.3);
