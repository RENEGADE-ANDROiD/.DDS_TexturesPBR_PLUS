		LFH2 C 4 A_FadeIn(0.3);
		LFH2 DEF 4;
		LFH2 G 4 A_FadeIn(0.4);
		LFH2 HI 4;
		TNT1 A 0 A_CheckSight("Nothing");
		TNT1 A 0 A_CheckRange(512,"Nothing",0);
		//TNT1 A 0 A_Jump(64,"Death");
		Goto SpiralLoop2;
	SpiralLoop:
		TNT1 A 0 A_CheckSight("Nothing");
		TNT1 A 0 A_CheckRange(512,"Nothing",0);
		LFH1 ABCD 4 A_SetAngle(angle+random(10,30));
		LFH1 EFGH 4 A_ChangeVelocity (random(1.0,2.0), 0.0, -0.5, CVF_RELATIVE|CVF_REPLACE);
		LFH1 I 1;
		Loop;
	SpiralLoop2:
		TNT1 A 0 A_CheckSight("Nothing");
		TNT1 A 0 A_CheckRange(512,"Nothing",0);
		LFH2 ABCD 4 A_SetAngle(angle+random(10,30));
		LFH2 EFGH 4 A_ChangeVelocity (random(1.0,2.0), 0.0, -0.5, CVF_RELATIVE|CVF_REPLACE);
		LFH2 I 1;
		Loop;
	Death:
		LFH3 ABCDE 10 {
			A_FadeOut(0.3);
			scale = (self.scale.x-0.05,self.scale.y-0.05);
		}
		Goto Nothing;
	}
}

const STAT_HDFLASH = Thinker.STAT_USER + 10;

#include "zscript/hd_relite_Events.zs"
#include "zscript/hd_shadowactors.zs"
#include "zscript/hd_lightactors.zs"
