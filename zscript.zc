Class VerySimpleRainHandler : EventHandler
{
	Actor player;
	int randomcolor;
	int randomweather;
	int weatherchange;
	int raincolorchange;
	int randomactive;
	int randomrain;
	
	override void WorldLoaded(WorldEvent e){

		CVar.FindCVar("rottlightning").SetInt(0);
		CVar.FindCVar("rottindoors").SetInt(0);
		CVar.FindCVar("windchange").SetInt(0);
		CVar.FindCVar("weatherchange").SetInt(0);
		CVar.FindCVar("raincolorchange").SetInt(0);
		CVar.FindCVar("quakedelay").SetInt(0);
		CVar.FindCVar("indoordelay").SetInt(6);
		CVar.FindCVar("outdoordelay").SetInt(6);
		randomweather = 0;
		weatherchange = 0;
		randomcolor = 0;
		raincolorchange = 0;
		randomactive = 0;
		randomrain = 0;

	}
	
	override void WorldTick(){

		if(CVar.FindCVar("raincolor").GetInt() == 7 && raincolorchange <= 1000 && randomcolor == 1 && CVar.FindCVar("weatheractive").GetInt() == 0 && randomrain == 7){
			raincolorchange++;
		}else{
			if(CVar.FindCVar("raincolor").GetInt() == 7 && CVar.FindCVar("weatheractive").GetInt() == 0){
				CVar.FindCVar("rainrandom").SetInt(random(0,6));
				while(CVar.FindCVar("rainrandom").GetInt() == CVar.FindCVar("raincoloractive").GetInt()){
					CVar.FindCVar("rainrandom").SetInt(random(0,6));
					if(CVar.FindCVar("rainrandom").GetInt() != CVar.FindCVar("raincoloractive").GetInt()){
						CVar.FindCVar("raincoloractive").SetInt(CVar.FindCVar("rainrandom").GetInt());
						raincolorchange = 0;
						randomcolor = 1;
						randomrain = 7;
						break;
					}			
				}
			}
		}

		if(CVar.FindCVar("raincolor").GetInt() < 7){
			CVar.FindCVar("raincoloractive").SetInt(CVar.FindCVar("raincolor").GetInt());
			raincolorchange = 0;
			randomcolor = 0;
			randomrain = 0;
		}

		if(CVar.FindCVar("raincolor").GetInt() == 8 && CVar.FindCVar("weatheractive").GetInt() == 0 && randomrain != 8){
			CVar.FindCVar("rainrandom").SetInt(random(0,6));
			while(CVar.FindCVar("rainrandom").GetInt() == CVar.FindCVar("raincoloractive").GetInt()){
				CVar.FindCVar("rainrandom").SetInt(random(0,6));
				if(CVar.FindCVar("rainrandom").GetInt() != CVar.FindCVar("raincoloractive").GetInt()){
					CVar.FindCVar("raincoloractive").SetInt(CVar.FindCVar("rainrandom").GetInt());
					if(CVar.FindCVar("weatheractive").GetInt() == 0){
						raincolorchange = 0;
						randomcolor = 1;
						randomrain = 8;
					}
					break;
				}			
			}
		}

		if(CVar.FindCVar("weathermode").GetInt() == 3 && weatherchange <= 3000 && randomweather == 1 && randomactive == 3){
			if(CVar.FindCVar("weathermode").GetInt() == 3){
				weatherchange++;
			}
		}else{
			if(CVar.FindCVar("weathermode").GetInt() == 3){
				CVar.FindCVar("weatherrandom").SetInt(random(0,2));
				while(CVar.FindCVar("weatherrandom").GetInt() == CVar.FindCVar("weatheractive").GetInt()){
					CVar.FindCVar("weatherrandom").SetInt(random(0,2));
					if(CVar.FindCVar("weatherrandom").GetInt() != CVar.FindCVar("weatheractive").GetInt()){
						CVar.FindCVar("weatheractive").SetInt(CVar.FindCVar("weatherrandom").GetInt());
						weatherchange = 0;
						randomweather = 1;
						randomactive = 3;
						if(CVar.FindCVar("weatheractive").GetInt() == 0){
							raincolorchange = 0;
							randomcolor = 0;
							randomrain = 0;
						}
						break;
					}			
				}
			}
		}

		if(CVar.FindCVar("weathermode").GetInt() < 3){
			if((CVar.FindCVar("weathermode").GetInt() != CVar.FindCVar("weatheractive").GetInt() || weatherchange != 0) && CVar.FindCVar("weathermode").GetInt() == 0){
				raincolorchange = 0;
				randomcolor = 0;
			}
			CVar.FindCVar("weatheractive").SetInt(CVar.FindCVar("weathermode").GetInt());
			randomweather = 0;
			weatherchange = 0;
			randomactive = 0;
		}

		if(CVar.FindCVar("weathermode").GetInt() == 4 && randomactive != 4){
			CVar.FindCVar("weatherrandom").SetInt(random(0,2));
			while(CVar.FindCVar("weatherrandom").GetInt() == CVar.FindCVar("weatheractive").GetInt()){
				CVar.FindCVar("weatherrandom").SetInt(random(0,2));
				if(CVar.FindCVar("weatherrandom").GetInt() != CVar.FindCVar("weatheractive").GetInt()){
					CVar.FindCVar("weatheractive").SetInt(CVar.FindCVar("weatherrandom").GetInt());
					weatherchange = 0;
					randomweather = 1;
					randomactive = 4;
					if(CVar.FindCVar("weatheractive").GetInt() == 0){
						raincolorchange = 0;
						randomcolor = 0;
						randomrain = 0;
					}
					break;
				}			
			}
		}

		if((CVar.FindCVar("weathermode").GetInt() == 1 || CVar.FindCVar("weathermode").GetInt() == 2) || (CVar.FindCVar("weathermode").GetInt() >= 3 && CVar.FindCVar("weatheractive").GetInt() >= 1)){
			CVar.FindCVar("windchange").SetInt(CVar.FindCVar("windchange").GetInt()+random(1,3));
			if(CVar.FindCVar("windchange").GetInt() >= 20000){
				CVar.FindCVar("windchange").SetInt(0);
			}
		}

		if(CVar.FindCVar("quakeactive").GetInt() == 1 || ((random(1,300) > 299 || CVar.FindCVar("quakedelay").GetInt() != 0) && CVar.FindCVar("quakeactive").GetInt() == 2 && CVar.FindCVar("quakedelay").GetInt() <= 1000)){
			if(CVar.FindCVar("quakeactive").GetInt() == 2 && CVar.FindCVar("quakedelay").GetInt() >= random(300,600)){
				CVar.FindCVar("quakedelay").SetInt(0);
			}else if(CVar.FindCVar("quakeactive").GetInt() == 2){
				CVar.FindCVar("quakedelay").SetInt(CVar.FindCVar("quakedelay").GetInt()+1);
			}
		}
		if(CVar.FindCVar("quakeactive").GetInt() == 0 && CVar.FindCVar("quakedelay").GetInt() != 0){
			CVar.FindCVar("quakedelay").SetInt(0);
		}
	}

	override void PlayerEntered(PlayerEvent e) {
		self.player = players[consoleplayer].mo;
		self.player.giveinventory("VerySimpleRainItem", 1);
	}
}

class VerySimpleRainItem : CustomInventory {
	RainSound SelfSound;
	RainSpawner SelfRain1;
	RainSpawner SelfRain2;
	RainSpawner SelfRain3;
	RainSpawner SelfRain4;
	RainSpawner SelfRain5;
	RainSpawner SelfRain6;
	RainSpawner SelfRain7;
	RainSpawner SelfRain8;
	RainSpawner SelfRain9;
	bool Active;
	int worldLoaded;

	default{
		Inventory.AltHUDIcon "UMBRA0";
		Inventory.MaxAmount 1;
		-INVENTORY.INVBAR
		-INVENTORY.AUTOACTIVATE
		+INVENTORY.PERSISTENTPOWER
		+INVENTORY.UNDROPPABLE
	}

	override void DoEffect() {
		super.DoEffect();

		if(CVar.FindCVar("rainactive").GetInt()){
			active = true;
		}else{
			active = false;
		}
		if(!SelfSound && worldLoaded == 3) { worldLoaded = 0; }

		if(Active && Level.Mapname != "TITLEMAP") {
			if(SelfRain1) { SelfRain1.Destroy(); }
			if(SelfRain2) { SelfRain2.Destroy(); }
			if(SelfRain3) { SelfRain3.Destroy(); }
			if(SelfRain4) { SelfRain4.Destroy(); }
			if(SelfRain5) { SelfRain5.Destroy(); }
			if(SelfRain6) { SelfRain6.Destroy(); }
			if(SelfRain7) { SelfRain7.Destroy(); }
			if(SelfRain8) { SelfRain8.Destroy(); }
			if(SelfRain9) { SelfRain9.Destroy(); }

			Vector3 a = (owner.pos.x,owner.pos.y,GetZAt(owner.pos.x,owner.pos.y,GZF_CEILING));
			Vector3 b = (owner.pos.x,owner.pos.y,owner.pos.z);

			if(!SelfSound && worldLoaded == 1){
				SelfSound = RainSound(Spawn("RainSound",b,false));
				SelfSound.FollowTarget = owner;
				worldLoaded = 3;
			}

			if(worldLoaded < 2){
				worldLoaded = 1;
			}

			SelfRain1 = RainSpawner(Spawn("RainSpawner",a,false));
			SelfRain1.FollowTarget = owner;
			SelfRain2 = RainSpawner(Spawn("RainSpawner",a,false));
			SelfRain2.FollowTarget = owner;
			SelfRain3 = RainSpawner(Spawn("RainSpawner",a,false));
			SelfRain3.FollowTarget = owner;

			if(CVar.FindCVar("rainintensity").GetInt() >= 1){
				SelfRain4 = RainSpawner(Spawn("RainSpawner",a,false));
				SelfRain4.FollowTarget = owner;
				SelfRain5 = RainSpawner(Spawn("RainSpawner",a,false));
				SelfRain5.FollowTarget = owner;
				SelfRain6 = RainSpawner(Spawn("RainSpawner",a,false));
				SelfRain6.FollowTarget = owner;				
			}

			if(CVar.FindCVar("rainintensity").GetInt() >= 2){
				SelfRain7 = RainSpawner(Spawn("RainSpawner",a,false));
				SelfRain7.FollowTarget = owner;
				SelfRain8 = RainSpawner(Spawn("RainSpawner",a,false));
				SelfRain8.FollowTarget = owner;
				SelfRain9 = RainSpawner(Spawn("RainSpawner",a,false));
				SelfRain9.FollowTarget = owner;
			}

		}
		else {
			if(SelfSound) { SelfSound.Destroy(); }
			if(SelfRain1) { SelfRain1.Destroy(); }
			if(SelfRain2) { SelfRain2.Destroy(); }
			if(SelfRain3) { SelfRain3.Destroy(); }
			if(SelfRain4) { SelfRain4.Destroy(); }
			if(SelfRain5) { SelfRain5.Destroy(); }
			if(SelfRain6) { SelfRain6.Destroy(); }
			if(SelfRain7) { SelfRain7.Destroy(); }
			if(SelfRain8) { SelfRain8.Destroy(); }
			if(SelfRain9) { SelfRain9.Destroy(); }
			worldLoaded = 0;
		}

	}

	States {
	Spawn:
		TNT1 A 0;
		UMBR A -1;
		Loop;
	Use:
		TNT1 A 1 ToggleActive();
		Loop;
	}

	action void ToggleActive() {
		if(CVar.FindCVar("rainactive").GetInt()){
			console.printf("RAIN OFF");
			CVar.FindCVar("rainactive").SetInt(0);
		}else{
			console.printf("RAIN ON");
			CVar.FindCVar("rainactive").SetInt(1);
		}
	}


}

class RainSpawner : Actor
{
	actor FollowTarget;
	int randomX;
	int randomY;
	int randomZ;
	PreSpawnerRottSFX SelfRottSFX;

	default{
		Radius 1;
		Height 1;
		+NoClip;
		+ClientSideOnly;
		+SpawnCeiling;
		+NoGravity;
	}

    override void Tick() {
        super.Tick();

		Vector3 a = (followtarget.pos.x,followtarget.pos.y,GetZAt(followtarget.pos.x,followtarget.pos.y,GZF_CEILING));
		SetOrigin(
            a,
            true);
    }

	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 0 {
			randomX = Random(-512,512);
			randomY = Random(-512,512);
			A_SpawnItemEx("PreSpawner", randomX, randomY, GetZAt(randomX,randomY), 0, 0, 0, 0 , 128, 0);
			randomX = Random(-512,512);
			randomY = Random(-512,512);
			A_SpawnItemEx("PreSpawner", randomX, randomY, GetZAt(randomX,randomY), 0, 0, 0, 0 , 128, 0);
			if(CVar.FindCVar("rainintensity").GetInt() >= 1){
				randomX = Random(-512,512);
				randomY = Random(-512,512);
				A_SpawnItemEx("PreSpawner", randomX, randomY, GetZAt(randomX,randomY), 0, 0, 0, 0 , 128, 0);
				randomX = Random(-512,512);
				randomY = Random(-512,512);
				A_SpawnItemEx("PreSpawner", randomX, randomY, GetZAt(randomX,randomY), 0, 0, 0, 0 , 128, 0);
			}
			if(CVar.FindCVar("rainintensity").GetInt() >= 2){
				randomX = Random(-512,512);
				randomY = Random(-512,512);
				A_SpawnItemEx("PreSpawner", randomX, randomY, GetZAt(randomX,randomY), 0, 0, 0, 0 , 128, 0);
				randomX = Random(-512,512);
				randomY = Random(-512,512);
				A_SpawnItemEx("PreSpawner", randomX, randomY, GetZAt(randomX,randomY), 0, 0, 0, 0 , 128, 0);
			}
			randomX = Random(Random(-512,-1024),Random(512,1024));
			randomY = Random(Random(-512,-1024),Random(512,1024));
			A_SpawnItemEx("PreSpawner", randomX, randomY, GetZAt(randomX,randomY), 0, 0, 0, 0 , 128, 0);
			randomX = Random(-512,512);
			randomY = Random(-512,512);
			Vector3 b = (self.pos.x+randomX,self.pos.y+randomY,GetZAt(self.pos.x+randomX,self.pos.y+randomY));
			if(!SelfRottSFX && CVar.FindCVar("rottsfx").GetInt()){
				SelfRottSFX = PreSpawnerRottSFX(Spawn("PreSpawnerRottSFX",b,false));
			}
			if(CVar.FindCVar("quakeactive").GetInt() == 1 || (CVar.FindCVar("quakeactive").GetInt() == 2 && CVar.FindCVar("quakedelay").GetInt() != 0)){
				int z = random(0,2);
				if(z == 0){
					A_QuakeEx(random(1,2), random(1,2), random(1,2), 35, 0, 3000,"");
				}
				if(z == 1){
					A_QuakeEx(random(2,4), random(2,4), random(2,4), 35, 0, 3000,"");
				}
				if(z == 2){
					A_QuakeEx(random(4,8), random(4,8), random(4,8), 35, 0, 3000,"");
				}
			}
		}
		TNT1 A 1;
		Loop;
	}
}

class PreSpawnerRottSFX : PreSpawner
{
	default{
		Radius 1;
		Height 1;
		+NoClip;
		+ClientSideOnly;
		+SpawnCeiling;
		+NoGravity;
	}

	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 0 A_JumpIf(!self.CurSector,"Nothing");
		TNT1 A 0 {
			spawnSpot = self.Vec2Offset(self.pos.x, self.pos.y);
			ceilingHeight = self.curSector.ceilingplane.ZatPoint(spawnSpot);
		}
		TNT1 A 1 A_SpawnItemEx("RottSFX", 0, 0, (ceilingHeight-self.pos.z)-2, 0, 0, 0, 0 , 128, 0);
		Goto Nothing;
	}
}

class RainBase : Actor
{
	protected bool, double CheckSky(Sector sec, Vector2 spot, double z)
	{
		bool sky;
		double ceilz;
		
		if (!sec)
			return sky, ceilz;
		
		Sector ceilSec;
		[ceilz, ceilSec] = sec.HighestCeilingAt(spot);
		if (ceilSec.GetTexture(Sector.ceiling) == skyflatnum)
		{
			double top = sec.NextHighestCeilingAt(spot.x, spot.y, z, z+1);
			if (top == ceilz)
				sky = true;
		}
		
		return sky, ceilz;
	}

	States
	{
	Nothing:
		TNT1 A 0;
		TNT1 A 0 {
			Destroy();
		}
		Stop;
	}
}

class RottSFX : RainBase
{
	actor player;
	Vector2 spawnSpot;
	Vector2 playerSpot;
	bool skyCheck;
	double ceilz;
	bool skyCheckPlayer;
	double ceilzPlayer;
	int randomSFX;
	int rottlightning;
	int delay;
	Vector3 x;
	int gotSight;

	default{
		Radius 512;
		Height 1;
		-NoClip;
		+ClientSideOnly;
		+SpawnCeiling;
		+NoGravity;
	}

    override void Tick() {
        super.Tick();

		self.player = players[consoleplayer].mo;
		playerSpot = self.player.Vec2Offset(self.player.pos.x, self.player.pos.y);
		[skyCheckPlayer, ceilzPlayer] = CheckSky(self.player.CurSector, playerSpot, self.player.curSector.ceilingplane.ZatPoint(playerSpot));

		if(skyCheckPlayer && CVar.FindCVar("rottindoors").GetInt() > 0){
			skyCheckPlayer = false;
		}
    }

	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 0 {
			delay = 3000;
			spawnSpot = self.Vec2Offset(self.pos.x, self.pos.y);
			[skyCheck, ceilz] = CheckSky(self.CurSector, spawnSpot, self.curSector.ceilingplane.ZatPoint(spawnSpot));
			if(skyCheck && ceilz > ceilingz){
				skyCheck = false;
			}
		}
		TNT1 A 0 A_JumpIf(random(1,100)>69||CVar.FindCVar("weatheractive").GetInt() != 0,"Nothing");
		TNT1 A 3;
		TNT1 A 0 {
			randomSFX = random(1,delay);
			if(((randomSFX > delay-3 && CVar.FindCVar("rottfrequency").GetInt() == 0) ||
				(randomSFX > delay-6 && CVar.FindCVar("rottfrequency").GetInt() == 1) ||
					(randomSFX > delay-9 && CVar.FindCVar("rottfrequency").GetInt() == 2)) && !CVar.FindCVar("rottlightning").GetInt()){
				if((CVar.FindCVar("rottindoors").GetInt() >= delay*0.009 && CVar.FindCVar("rottfrequency").GetInt() == 0 && !skyCheckPlayer)||
					(CVar.FindCVar("rottindoors").GetInt() >= delay*0.006 && CVar.FindCVar("rottfrequency").GetInt() == 1 && !skyCheckPlayer)||
						(CVar.FindCVar("rottindoors").GetInt() >= delay*0.003 && CVar.FindCVar("rottfrequency").GetInt() == 2 && !skyCheckPlayer)){
					CVar.FindCVar("rottindoors").SetInt(0);
					return A_Jump(256,"ThunderIndoors");
				}
				return A_Jump(256,"Lightning");
			}
			return ResolveState("Check");
		}
		Goto Nothing;
	Check:
		TNT1 A 0;
		TNT1 A 0 {
			randomSFX = random(1,delay);
			if(((randomSFX > delay-3 && CVar.FindCVar("rottfrequency").GetInt() == 0)||(randomSFX > delay-6 && CVar.FindCVar("rottfrequency").GetInt() == 1)
				||(randomSFX > delay-9 && CVar.FindCVar("rottfrequency").GetInt() == 2)) && CVar.FindCVar("rottlightning").GetInt()){
				CVar.FindCVar("rottlightning").SetInt(0);
				return A_Jump(256,"Thunder");			
			}
			return A_Jump(256,"Nothing");
		}
		Goto Nothing;
	Thunder:
		TNT1 A 0 A_JumpIf(!skyCheckPlayer && (!CVar.FindCVar("outdoordelay").GetInt() || !CVar.FindCVar("audiodelay").GetInt()),"ThunderIndoors");
		TNT1 A 1 {
			if(CVar.FindCVar("audiolevel").GetInt() == 2){
				A_PlaySound("rott/thunder",5|64|4096,1.0,false,ATTN_NONE);
			}
			if(CVar.FindCVar("audiolevel").GetInt() == 1){
				A_PlaySound("rott/thunderlower",5|64|4096,1.0,false,ATTN_NONE);
			}
			if(CVar.FindCVar("audiolevel").GetInt() == 0){
				A_PlaySound("rott/thunderevenlower",5|64|4096,1.0,false,ATTN_NONE);
			}
		}
		Goto Nothing;
	ThunderIndoors:
		TNT1 A 1 {
			if(CVar.FindCVar("audiolevel").GetInt() == 2){
				A_PlaySound("rott/thunderlower",5|64|4096,1.0,false,ATTN_NONE);
			}
			if(CVar.FindCVar("audiolevel").GetInt() == 1){
				A_PlaySound("rott/thunderevenlower",5|64|4096,1.0,false,ATTN_NONE);
			}
			if(CVar.FindCVar("audiolevel").GetInt() == 0){
				A_PlaySound("rott/thunderveryquiet",5|64|4096,1.0,false,ATTN_NONE);
			}
		}
		Goto Nothing;
	Lightning:
		TNT1 A 0 A_JumpIf(!skyCheck,"NoLightning");		
		TNT1 A 0 {
			gotSight = 0;
			if(!CheckSight(self.player) || self.pos.z-self.player.pos.z > 512){
				float oldPos = self.pos.z;

				for(float z = self.pos.z;z--;z == floorz){

					if(self.pos.z < floorz){
						break;
					}

					x = (self.pos.x,self.pos.y,self.pos.z-1);
					SetXYZ(x);

					if(CheckSight(self.player) && self.pos.z <= self.player.ceilingz && self.pos.z-self.player.pos.z < 512){
						gotSight = 1;
						break;
					}

				}
			}else{
				gotSight = 1;
			}
		}
		TNT1 A 0 A_JumpIf(!gotSight,"NoLightning");
		TNT1 A 0 {
			CVar.FindCVar("rottlightning").SetInt(1);
			CVar.FindCVar("rottindoors").SetInt(0);
		}
		TNT1 A 0 A_Jump(256,"Lightning1","Lightning2","Lightning3");
		Goto Nothing;
	Lightning1:
		RSFX A random(12,15);
		Goto Nothing;
	Lightning2:
		RSFX B random(12,15);
		Goto Nothing;
	Lightning3:
		RSFX C random(12,15);
		Goto Nothing;
	NoLightning:
		TNT1 A 0 {
			CVar.FindCVar("rottindoors").SetInt(CVar.FindCVar("rottindoors").GetInt()+1);
		}
		Goto Nothing;
	}
}

class RainSound : RainBase
{
	actor FollowTarget;
	Vector2 spawnSpot;
	bool skyCheck;
	double ceilz;
	int rainIntensity;
	int weather;
	actor player;

	default{
		Radius 1;
		Height 1;
		+NoClip;
		+ClientSideOnly;
		-SpawnCeiling;
		-NoGravity;
	}

	override void Tick() {
		super.Tick();

		rainIntensity = CVar.FindCVar("rainintensity").GetInt();
		weather = CVar.FindCVar("weathermode").GetInt();

		Vector3 a = (followtarget.pos.x,followtarget.pos.y,followtarget.pos.z);
		SetOrigin(
			a,
			true);
	}

	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 B 3;
		TNT1 A 0 {
			self.player = players[consoleplayer].mo;
			spawnSpot = self.Vec2Offset(self.pos.x, self.pos.y);
			[skyCheck, ceilz] = CheckSky(self.CurSector, spawnSpot, self.curSector.ceilingplane.ZatPoint(spawnSpot));

			if(skyCheck && ceilz > ceilingz){
				if(!CVar.FindCVar("rottindoors").GetInt()){
					CVar.FindCVar("rottindoors").SetInt(1);
				}
				skyCheck = false;
			}else if(skyCheck){
				CVar.FindCVar("rottindoors").SetInt(0);
			}
		}
		TNT1 A 0 A_JumpIf(CVar.FindCVar("audiolevel").GetInt() == -1,"Mute");
		TNT1 A 0 A_JumpIf(!skyCheck && rainIntensity == 0,"IndoorLow");
		TNT1 A 0 A_JumpIf(!skyCheck && rainIntensity == 1,"IndoorMedium");
		TNT1 A 0 A_JumpIf(!skyCheck && rainIntensity == 2,"IndoorHigh");
		TNT1 A 0 A_JumpIf(skyCheck && rainIntensity == 0,"Low");
		TNT1 A 0 A_JumpIf(skyCheck && rainIntensity == 1,"Medium");
		TNT1 A 0 A_JumpIf(skyCheck && rainIntensity == 2,"High");
		Loop;
	Low:
		TNT1 A 0 {
			if(CVar.FindCVar("audiodelay").GetInt()){
				CVar.FindCVar("indoordelay").SetInt(0);
				CVar.FindCVar("outdoordelay").SetInt(CVar.FindCVar("outdoordelay").GetInt()+1);	
				if(CVar.FindCVar("outdoordelay").GetInt()==9){
					CVar.FindCVar("outdoordelay").SetInt(0);
				}
			}
		}
		TNT1 A 0 A_JumpIf(CVar.FindCVar("outdoordelay").GetInt() >= 1 && CVar.FindCVar("audiodelay").GetInt(),"Spawn");
		TNT1 A 2 {
			if(CVar.FindCVar("weathermode").GetInt() == 0 || (CVar.FindCVar("weathermode").GetInt() >= 3 && CVar.FindCVar("weatherrandom").GetInt() == 0)){
				A_PlaySound("weather/rainevenlower",7|64|256|4096,1.0,true,ATTN_NONE);
			}else if(CVar.FindCVar("weathermode").GetInt() == 1 || CVar.FindCVar("weathermode").GetInt() == 2 || (CVar.FindCVar("weathermode").GetInt() >= 3 && (CVar.FindCVar("weatherrandom").GetInt() == 1 || CVar.FindCVar("weatherrandom").GetInt() == 2))){
				A_PlaySound("weather/windevenlower",7|64|256|4096,1.0,true,ATTN_NONE);
			}
			if(CVar.FindCVar("quakeactive").GetInt() == 1 || CVar.FindCVar("quakedelay").GetInt() != 0){
				A_PlaySound("weather/quakeevenlower",6|64|256|4096,1.0,true,ATTN_NONE);
			}else{
				A_StopSound(6);
			}
		}
		Goto Spawn;
	Medium:
		TNT1 A 0 A_JumpIf(CVar.FindCVar("audiolevel").GetInt() == 0,"Low");
		TNT1 A 0 {
			if(CVar.FindCVar("audiodelay").GetInt()){
				CVar.FindCVar("indoordelay").SetInt(0);
				CVar.FindCVar("outdoordelay").SetInt(CVar.FindCVar("outdoordelay").GetInt()+1);	
				if(CVar.FindCVar("outdoordelay").GetInt()==9){
					CVar.FindCVar("outdoordelay").SetInt(0);
				}
			}
		}
		TNT1 A 0 A_JumpIf(CVar.FindCVar("outdoordelay").GetInt() >= 1 && CVar.FindCVar("audiodelay").GetInt(),"Spawn");
		TNT1 A 2 {
			if(CVar.FindCVar("weathermode").GetInt() == 0 || (CVar.FindCVar("weathermode").GetInt() >= 3 && CVar.FindCVar("weatherrandom").GetInt() == 0)){
				A_PlaySound("weather/rainlower",7|64|256|4096,1.0,true,ATTN_NONE);
			}else if(CVar.FindCVar("weathermode").GetInt() == 1 || CVar.FindCVar("weathermode").GetInt() == 2 || (CVar.FindCVar("weathermode").GetInt() >= 3 && (CVar.FindCVar("weatherrandom").GetInt() == 1 || CVar.FindCVar("weatherrandom").GetInt() == 2))){
				A_PlaySound("weather/windlower",7|64|256|4096,1.0,true,ATTN_NONE);
			}
			if(CVar.FindCVar("quakeactive").GetInt() == 1 || CVar.FindCVar("quakedelay").GetInt() != 0){
				A_PlaySound("weather/quakelower",6|64|256|4096,1.0,true,ATTN_NONE);
			}else{
				A_StopSound(6);
			}
			
		}
		Goto Spawn;
	High:
		TNT1 A 0 A_JumpIf(CVar.FindCVar("audiolevel").GetInt() == 1,"Medium");
		TNT1 A 0 A_JumpIf(CVar.FindCVar("audiolevel").GetInt() == 0,"Low");
		TNT1 A 0 {
			if(CVar.FindCVar("audiodelay").GetInt()){
				CVar.FindCVar("indoordelay").SetInt(0);
				CVar.FindCVar("outdoordelay").SetInt(CVar.FindCVar("outdoordelay").GetInt()+1);	
				if(CVar.FindCVar("outdoordelay").GetInt()==9){
					CVar.FindCVar("outdoordelay").SetInt(0);
				}
			}
		}
		TNT1 A 0 A_JumpIf(CVar.FindCVar("outdoordelay").GetInt() >= 1 && CVar.FindCVar("audiodelay").GetInt(),"Spawn");
		TNT1 A 2 {
			if(CVar.FindCVar("weathermode").GetInt() == 0 || (CVar.FindCVar("weathermode").GetInt() >= 3 && CVar.FindCVar("weatherrandom").GetInt() == 0)){
				A_PlaySound("weather/rain",7|64|256|4096,1.0,true,ATTN_NONE);
			}else if(CVar.FindCVar("weathermode").GetInt() == 1 || CVar.FindCVar("weathermode").GetInt() == 2 || (CVar.FindCVar("weathermode").GetInt() >= 3 && (CVar.FindCVar("weatherrandom").GetInt() == 1 || CVar.FindCVar("weatherrandom").GetInt() == 2))){
				A_PlaySound("weather/wind",7|64|256|4096,1.0,true,ATTN_NONE);
			}
			if(CVar.FindCVar("quakeactive").GetInt() == 1 || CVar.FindCVar("quakedelay").GetInt() != 0){
				A_PlaySound("weather/quake",6|64|256|4096,1.0,true,ATTN_NONE);
			}else{
				A_StopSound(6);
			}
		}
		Goto Spawn;
	IndoorLow:
		TNT1 A 0 {
			if(CVar.FindCVar("audiodelay").GetInt()){
				CVar.FindCVar("outdoordelay").SetInt(0);
				CVar.FindCVar("indoordelay").SetInt(CVar.FindCVar("indoordelay").GetInt()+1);	
				if(CVar.FindCVar("indoordelay").GetInt()==9){
					CVar.FindCVar("indoordelay").SetInt(0);
				}
			}
		}
		TNT1 A 0 A_JumpIf(CVar.FindCVar("indoordelay").GetInt() >= 1 && CVar.FindCVar("audiodelay").GetInt(),"Spawn");
		TNT1 A 2 {
			if(CVar.FindCVar("weathermode").GetInt() == 0 || (CVar.FindCVar("weathermode").GetInt() >= 3 && CVar.FindCVar("weatherrandom").GetInt() == 0)){
				A_PlaySound("weather/rainveryquiet",7|64|256|4096,1.0,true,ATTN_NONE);
			}else if(CVar.FindCVar("weathermode").GetInt() == 1 || CVar.FindCVar("weathermode").GetInt() == 2 || (CVar.FindCVar("weathermode").GetInt() >= 3 && (CVar.FindCVar("weatherrandom").GetInt() == 1 || CVar.FindCVar("weatherrandom").GetInt() == 2))){
				A_PlaySound("weather/windveryquiet",7|64|256|4096,1.0,true,ATTN_NONE);
			}
			if(CVar.FindCVar("quakeactive").GetInt() == 1 || CVar.FindCVar("quakedelay").GetInt() != 0){
				A_PlaySound("weather/quakeveryquiet",6|64|256|4096,1.0,true,ATTN_NONE);
			}else{
				A_StopSound(6);
			}
		}
		Goto Spawn;
	IndoorMedium:
		TNT1 A 0 A_JumpIf(CVar.FindCVar("audiolevel").GetInt() == 0,"IndoorLow");
		TNT1 A 0 {
			if(CVar.FindCVar("audiodelay").GetInt()){
				CVar.FindCVar("outdoordelay").SetInt(0);
				CVar.FindCVar("indoordelay").SetInt(CVar.FindCVar("indoordelay").GetInt()+1);	
				if(CVar.FindCVar("indoordelay").GetInt()==9){
					CVar.FindCVar("indoordelay").SetInt(0);
				}
			}
		}
		TNT1 A 0 A_JumpIf(CVar.FindCVar("indoordelay").GetInt() >= 1 && CVar.FindCVar("audiodelay").GetInt(),"Spawn");
		TNT1 A 2 {
			if(CVar.FindCVar("weathermode").GetInt() == 0 || (CVar.FindCVar("weathermode").GetInt() >= 3 && CVar.FindCVar("weatherrandom").GetInt() == 0)){
				A_PlaySound("weather/rainevenlower",7|64|256|4096,1.0,true,ATTN_NONE);
			}else if(CVar.FindCVar("weathermode").GetInt() == 1 || CVar.FindCVar("weathermode").GetInt() == 2 || (CVar.FindCVar("weathermode").GetInt() >= 3 && (CVar.FindCVar("weatherrandom").GetInt() == 1 || CVar.FindCVar("weatherrandom").GetInt() == 2))){
				A_PlaySound("weather/windevenlower",7|64|256|4096,1.0,true,ATTN_NONE);
			}
			if(CVar.FindCVar("quakeactive").GetInt() == 1 || CVar.FindCVar("quakedelay").GetInt() != 0){
				A_PlaySound("weather/quakeevenlower",6|64|256|4096,1.0,true,ATTN_NONE);
			}else{
				A_StopSound(6);
			}
		}
		Goto Spawn;
	IndoorHigh:
		TNT1 A 0 A_JumpIf(CVar.FindCVar("audiolevel").GetInt() == 1,"IndoorMedium");
		TNT1 A 0 A_JumpIf(CVar.FindCVar("audiolevel").GetInt() == 0,"IndoorLow");
		TNT1 A 0 {
			if(CVar.FindCVar("audiodelay").GetInt()){
				CVar.FindCVar("outdoordelay").SetInt(0);
				CVar.FindCVar("indoordelay").SetInt(CVar.FindCVar("indoordelay").GetInt()+1);	
				if(CVar.FindCVar("indoordelay").GetInt()==9){
					CVar.FindCVar("indoordelay").SetInt(0);
				}
			}
		}
		TNT1 A 0 A_JumpIf(CVar.FindCVar("indoordelay").GetInt() >= 1 && CVar.FindCVar("audiodelay").GetInt(),"Spawn");
		TNT1 A 2 {
			if(CVar.FindCVar("weathermode").GetInt() == 0 || (CVar.FindCVar("weathermode").GetInt() >= 3 && CVar.FindCVar("weatherrandom").GetInt() == 0)){
				A_PlaySound("weather/rainlower",7|64|256|4096,1.0,true,ATTN_NONE);
			}else if(CVar.FindCVar("weathermode").GetInt() == 1 || CVar.FindCVar("weathermode").GetInt() == 2 || (CVar.FindCVar("weathermode").GetInt() >= 3 && (CVar.FindCVar("weatherrandom").GetInt() == 1 || CVar.FindCVar("weatherrandom").GetInt() == 2))){
				A_PlaySound("weather/windlower",7|64|256|4096,1.0,true,ATTN_NONE);
			}
			if(CVar.FindCVar("quakeactive").GetInt() == 1 || CVar.FindCVar("quakedelay").GetInt() != 0){
				A_PlaySound("weather/quakelower",6|64|256|4096,1.0,true,ATTN_NONE);
			}else{
