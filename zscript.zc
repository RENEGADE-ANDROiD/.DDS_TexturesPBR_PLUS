//========================================================================
//====== SMOKE ===========================================================
//========================================================================


Class Smoke : VisualSpecialEffect
{
	Default
	{
		Radius 0;
		Height 0;
		RenderStyle "Shaded";
		StencilColor "44 44 44";
		Alpha 0.06;
		Scale 0.25;
		Gravity -0.12;
		Speed 0.25;
	}
	States
	{
		Spawn:
			TNT1 A 0;
			TNT1 A 0 A_Jump(255,"Spawn1", "Spawn2");
		Spawn1:
			SMOK C 2 A_SetRoll(roll + random(-359,359));
			SMOK CCCC random(1,3)
				{
					A_FadeIn(0.05);
					A_SetRoll(roll + 3);
					A_SetScale(scale.x * 1.35);
				}
			SMOK CCCCCCCCCCCCCCCCCCCCC random(1,3)
				{
					A_FadeOut(0.015);
					A_SetRoll(roll + 3);
					A_SetScale(scale.x * 1.05);
				}
			SMOK CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC random(1,3)
				{
					A_FadeOut(0.006);
					A_SetRoll(roll + 2);
					A_SetScale(scale.x * 1.02);
				}
		Fadeout:
			SMOK CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC random(1,3)
				{
					A_FadeOut(0.0005);
					A_SetRoll(roll + 1);
					A_SetScale(scale.x * 1.01);
				}
			Loop;
		Spawn2:
			SMOK C 2 A_SetRoll(roll + random(-359,359));
			SMOK CCCC random(1,3)
				{
					A_FadeIn(0.05);
					A_SetRoll(roll - 3);
					A_SetScale(scale.x * 1.35);
				}
			SMOK CCCCCCCCCCCCCCCCCCCCC random(1,3)
				{
					A_FadeOut(0.015);
					A_SetRoll(roll - 3);
					A_SetScale(scale.x * 1.05);
				}
			SMOK CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC random(1,3)
				{
					A_FadeOut(0.006);
					A_SetRoll(roll - 2);
					A_SetScale(scale.x * 1.02);
				}
		Fadeout:
			SMOK CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC random(1,3)
				{
					A_FadeOut(0.0005);
					A_SetRoll(roll - 1);
					A_SetScale(scale.x * 1.01);
				}
			Loop;
	}
}


