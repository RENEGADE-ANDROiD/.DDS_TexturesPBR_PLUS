actor Kaboom
{
  Renderstyle Add
  alpha 0.9
  damage 0
  scale 1.25
  PROJECTILE
  +RANDOMIZE
  states
  {
  Spawn:
    MISL C 2 bright
    MISL B 2 bright A_PlaySoundEx("Kaboom", "body")
	MISL B 1 bright
	MISL C 1 bright 
			{
			A_SpawnItemEx("SmokeSmall1", 0, 0, random(1, 24), random(-1, 1), 0, random(0, 1));
			A_SpawnItemEx("SmokeSmall2", 0, 0, random(1, 24), 0, random(-1, 1), 0);
			A_SpawnItemEx("SmokeSmall1", 0, 0, random(1, 24), random(-1, 1), 0, random(0, 1));
			A_SpawnItemEx("SmokeSmall2", 0, 0, random(1, 24), 0, random(-1, 1), 0);
			A_SpawnItemEx("SmokeSmall1", 0, 0, random(1, 24), random(-1, 1), 0, random(0, 1));
			A_SpawnItemEx("SmokeSmall2", 0, 0, random(1, 24), 0, random(-1, 1), 0);
			}
	MISL C 2 bright 
    MISL D 3 bright 
    MISL EF 3 bright
			{
			A_SpawnItemEx("StillSmoke", 0, 0, random(1, 24));
			A_SpawnItemEx("StillSmoke", 0, 0, random(1, 24));
			A_SpawnItemEx("StillSmoke", 0, 0, random(1, 24));
			}
    stop
  }
}

