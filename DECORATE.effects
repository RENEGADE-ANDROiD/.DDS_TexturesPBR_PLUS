Actor SmokeSmall
{
  +NOGRAVITY
  +NOINTERACTION
  +NOBLOCKMAP
  +NOTELEPORT
  +ForceXYBillboard
  +ROLLSPRITE
  Translation "0:255=#[128,128,128]"
  Radius 0
  Height 0
  RenderStyle Translucent
  Alpha 0.01
  Scale 0.5
  States
  {
  Spawn:
    BAL2 DDDDDD 2
		{
		A_FadeOut(0.001);
		A_SetRoll(0);
		A_SetScale(0.3);
		}
    BAL2 DDDDDD 2
		{
		A_FadeOut(0.001);
		A_SetRoll(2);
		A_SetScale(0.4);
		}
    BAL2 DDDDDD 2
		{
		A_FadeOut(0.001);
		A_SetRoll(4);
		A_SetScale(0.5);
		}
    BAL2 DDDDDD 3
		{
		A_FadeOut(0.001);
		A_SetRoll(6);
		A_SetScale(0.6);
		}
    BAL2 DDDDDD 3
		{
		A_FadeOut(0.001);
		A_SetRoll(8);
		A_SetScale(0.7);
		}
    BAL2 DDDDDD 3
		{
		A_FadeOut(0.001);
		A_SetRoll(10);
		A_SetScale(0.8);
		}
    BAL2 DDDDDD 3
		{
		A_FadeOut(0.001);
		A_SetRoll(12);
		A_SetScale(0.9);
		}
    BAL2 DDDDDD 4
		{
		A_FadeOut(0.001);
		A_SetRoll(14);
		A_SetScale(1);
		}
    BAL2 DDDDDD 4
		{
		A_FadeOut(0.001);
		A_SetRoll(16);
		A_SetScale(1);
		}
    BAL2 DDDDDD 4
		{
		A_FadeOut(0.001);
		A_SetRoll(18);
		A_SetScale(1);
		}
    BAL2 DDDDDD 4
		{
		A_FadeOut(0.001);
		A_SetRoll(20);
		A_SetScale(1);
		}
    Goto Death
  Death:
    BAL2 DDDDDD 4
		{
		A_FadeOut(0.01);
		}
	Loop
  }
}

