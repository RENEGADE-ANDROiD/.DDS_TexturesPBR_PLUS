///////////////////////////////////////////
//core
///////////////////////////////////////////
//Core Splash definition for others to inherit from


ACTOR DDS_NJCoreSplashBase
{
	+NOBLOCKMAP
	+NOCLIP
	+DONTSPLASH
	+DONTBLAST
	+NOINTERACTION
	+NOTELEPORT
	+NOSPRITESHADOW
	Radius 2
	Height 4
	Renderstyle Translucent
	Alpha 0.85
	Scale 1.15
}

ACTOR DDS_NJCoreSplashSmoke
{
	+NOBLOCKMAP
	+NOCLIP
	+NOGRAVITY
	+DONTSPLASH
	+DONTBLAST
	Radius 2
	Height 4
	RenderStyle Add
	Alpha 0.85
}

///////////////////////////////////////////
//Blood
///////////////////////////////////////////
Actor DDS_NJBloodChunk : LiquidParticle
{
	TRANSLATION "112:127=184:191"
}

Actor DDS_NJBloodBase : DDS_NJCoreSplashBase
{
	TRANSLATION "112:127=184:191"
	States
	{
	Spawn:
		TNT1 AAAAAAAA 0 A_SpawnItemEx("DDS_NJBloodChunk",0.1*random(-12,12),0.1*random(-12,12),7,0.11*random(-22,22),0.11*random(-22,22),random(2,8))
		NWAT EFG 3
		NWAT H 3 A_SetTranslucent(0.6, 0)
		NWAT I 4 A_SetTranslucent(0.5, 0)
		NWAT J 4 A_SetTranslucent(0.4, 0)
		NWAT K 4 A_SetTranslucent(0.3, 0)
		Stop
	}
}


///////////////////////////////////////////
//Lava
///////////////////////////////////////////
ACTOR DDS_NJLavaSmoke : FlameSmoke
{
}

Actor DDS_NJLavaBase : DDS_NJCoreSplashBase
{
	+BRIGHT
	TRANSLATION "112:127=160:167"
	States
	{
	Spawn:
		NLAV AB 5 Light("FlameLight")
		NLAV CDEF 5
		Stop
	}
}

///////////////////////////////////////////
//Lava DDS_Smoke Only
///////////////////////////////////////////
ACTOR DDS_NJLavaSmokeOnly : FlameSmoke
{
}

///////////////////////////////////////////
//Nukage
///////////////////////////////////////////
Actor DDS_NJNukageSmoke : DDS_BarSmoke
{
}

Actor DDS_NJNukageChunk1 : SlimeParticle
{
	+BRIGHT
	TRANSLATION "112:127=112:122"
}
Actor DDS_NJNukageChunk2 : SlimeParticle
{
	+BRIGHT
	RenderStyle Add
	TRANSLATION "112:127=112:122"
}

ACTOR DDS_NJNukageChunk : RandomSpawner
{
	dropitem "DDS_NJNukageChunk1"
	dropitem "DDS_NJNukageChunk2"
}

Actor DDS_NJNukageBase : DDS_NJCoreSplashBase
{
	+BRIGHT
	Translation "112:127=112:125"
	States
	{
	Spawn:
		TNT1 AAAAAAAA 0 A_SpawnItemEx("DDS_NJNukageChunk",0.1*random(-12,12),0.1*random(-12,12),16,0.1*random(-22,22),0.1*random(-22,22),0.1*random(13,84))
		NWAT EFGH 4
		NWAT I 4 A_SetTranslucent(0.5, 1)
		NWAT J 5 A_SetTranslucent(0.4, 1)
		NWAT K 5 A_SetTranslucent(0.3, 1)
		Stop
	}
}


///////////////////////////////////////////
//Slime - Brown
///////////////////////////////////////////
Actor DDS_NJSlimeBrownChunk : SlimeParticle
{
	TRANSLATION "112:127=[107,71,39]:[23,15,7]"
}

Actor DDS_NJSlimeBrownBase : DDS_NJCoreSplashBase
{
	TRANSLATION "112:127=[107,71,39]:[23,15,7]"
	States
	{
	Spawn:
		TNT1 AAAAAAAA 0 A_SpawnItemEx("DDS_NJSlimeBrownChunk",0.1*random(-12,12),0.1*random(-12,12),16,0.1*random(-22,22),0.1*random(-22,22),0.1*random(11,77))
		NSL1 EFG 4
		NSL1 H 5 A_SetTranslucent(0.6, 0)
		NSL1 I 5 A_SetTranslucent(0.5, 0)
		NSL1 J 5 A_SetTranslucent(0.4, 0)
		NSL1 K 5 A_SetTranslucent(0.3, 0)
		Stop
	}
}

///////////////////////////////////////////
//Sludge - GreenyBrown
///////////////////////////////////////////
Actor DDS_NJSludgeChunk : SlimeParticle
{
	TRANSLATION "112:123=116:127", "124:127=76:79"
}

Actor DDS_NJSludgeBase : DDS_NJCoreSplashBase
{
	TRANSLATION 	"112:123=116:127", 
			"124:124=79:79", 
			"125:125=239:239", 
			"126:127=1:2" 
	States
	{
	Spawn:
		TNT1 AAAAAAAA 0 A_SpawnItemEx("DDS_NJSludgeChunk",0.1*random(-12,12),0.1*random(-12,12),16,0.1*random(-22,22),0.1*random(-22,22),0.1*random(11,77))
		NSL2 EFGH 4
		NSL2 I 5 A_SetTranslucent(0.7, 0)
		NSL2 J 5 A_SetTranslucent(0.5, 0)
		NSL2 K 5 A_SetTranslucent(0.3, 0)
		Stop
	}
}

///////////////////////////////////////////
//Water Normal
///////////////////////////////////////////
Actor DDS_NJWaterSplashChunk : LiquidParticle
{
	Alpha 0.5
	TRANSLATION "112:127=194:205"
}

Actor DDS_NJWaterSplashBase : DDS_NJCoreSplashBase
{
	Alpha 0.5
	TRANSLATION "112:119=200:207", "120:127=240:247"
	States
	{
	Spawn:
		TNT1 AAAAAAAAAA 0 A_SpawnItemEx("DDS_NJWaterSplashChunk",0.1*random(-12,12),0.1*random(-12,12),7,0.12*random(-22,22),0.12*random(-22,22),random(3,9))
		NWAT E 4 
		SPHG ABC 3
		SPHG D 3 A_SetTranslucent(0.6, 0)
		SPHG E 3 A_SetTranslucent(0.6, 0)
		NWAT K 3 A_SetTranslucent(0.5, 0)
		Stop
	}
}

