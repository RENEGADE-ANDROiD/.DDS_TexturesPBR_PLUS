///////////////////////////////////////////
//core
///////////////////////////////////////////
//Core Splash definition for others to inherit from


ACTOR NJCoreSplashBase
{
	+NOBLOCKMAP
	+NOCLIP
	+DONTSPLASH
	+DONTBLAST
	+NOINTERACTION
	+NOTELEPORT
	+NOSPRITESHADOW
	Radius 2
	Height 4
	Renderstyle Translucent
	Alpha 0.85
	Scale 1.15
}

ACTOR NJCoreSplashSmoke
{
	+NOBLOCKMAP
	+NOCLIP
	+NOGRAVITY
	+DONTSPLASH
	+DONTBLAST
	Radius 2
	Height 4
	RenderStyle Add
	Alpha 0.85
}

///////////////////////////////////////////
//Blood
///////////////////////////////////////////
Actor NJBloodChunk : LiquidParticle
{
	TRANSLATION "112:127=184:191"
}

Actor NJBloodBase : NJCoreSplashBase
{
	TRANSLATION "112:127=184:191"
	States
	{
	Spawn:
		TNT1 AAAAAAAA 0 A_SpawnItemEx("NJBloodChunk",0.1*random(-12,12),0.1*random(-12,12),7,0.11*random(-22,22),0.11*random(-22,22),random(2,8))
		NWAT EFG 3
		NWAT H 3 A_SetTranslucent(0.6, 0)
		NWAT I 4 A_SetTranslucent(0.5, 0)
		NWAT J 4 A_SetTranslucent(0.4, 0)
		NWAT K 4 A_SetTranslucent(0.3, 0)
		Stop
	}
}


///////////////////////////////////////////
//Lava
///////////////////////////////////////////
ACTOR NJLavaSmoke : NJCoreSplashSmoke
{
	States
	{
	Spawn:
		NLAV G 5
		NLAV H 5 A_SetTranslucent(0.6, 0)
		NLAV I 5 A_SetTranslucent(0.5, 0)
		NLAV J 5 A_SetTranslucent(0.4, 0)
		NLAV K 5 A_SetTranslucent(0.3, 0)
		Stop
	}
}

Actor NJLavaBase : NJCoreSplashBase
{
	+BRIGHT
	TRANSLATION "112:127=160:167"
	States
	{
	Spawn:
		NLAV AB 5 Light("FlameLight")
		NLAV CDEF 5
		Stop
	}
}

///////////////////////////////////////////
//Lava splash particles only
///////////////////////////////////////////
ACTOR NJLavaSmokeOnly : NJCoreSplashSmoke
{
	States
	{
	Spawn:
		NLAV G 5
		NLAV H 5 A_SetTranslucent(0.6, 0)
		NLAV I 5 A_SetTranslucent(0.5, 0)
		NLAV J 5 A_SetTranslucent(0.4, 0)
		NLAV K 5 A_SetTranslucent(0.3, 0)
		Stop
	}
}

///////////////////////////////////////////
//Nukage
///////////////////////////////////////////
Actor NJNukageSmoke : NJCoreSplashSmoke
{
	States
	{
	Spawn:
		NLAV G 5
		NLAV H 5 A_SetTranslucent(0.6, 0)
		NLAV I 5 A_SetTranslucent(0.5, 0)
		NLAV J 5 A_SetTranslucent(0.4, 0)
		NLAV K 5 A_SetTranslucent(0.3, 0)
		Stop
	}
}

Actor NJNukageChunk1 : SlimeParticle
{
	+BRIGHT
	TRANSLATION "112:127=112:122"
}
Actor NJNukageChunk2 : SlimeParticle
{
	+BRIGHT
	RenderStyle Add
	TRANSLATION "112:127=112:122"
}

ACTOR NJNukageChunk : RandomSpawner
{
	dropitem "NJNukageChunk1"
	dropitem "NJNukageChunk2"
}

Actor NJNukageBase : NJCoreSplashBase
{
	+BRIGHT
	Translation "112:127=112:125"
	States
	{
	Spawn:
		TNT1 AAAAAAAA 0 A_SpawnItemEx("NJNukageChunk",0.1*random(-12,12),0.1*random(-12,12),16,0.1*random(-22,22),0.1*random(-22,22),0.1*random(13,84))
		NWAT EFGH 4
		NWAT I 4 A_SetTranslucent(0.5, 1)
		NWAT J 5 A_SetTranslucent(0.4, 1)
		NWAT K 5 A_SetTranslucent(0.3, 1)
		Stop
	}
}


