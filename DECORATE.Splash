///////////////////////////////////////////
//Sludge - GreenyBrown
///////////////////////////////////////////
Actor NJSludgeChunk : SlimeParticle
{
	TRANSLATION "112:123=116:127", "124:127=76:79"
}

Actor NJSludgeBase : NJCoreSplashBase
{
	TRANSLATION 	"112:123=116:127", 
			"124:124=79:79", 
			"125:125=239:239", 
			"126:127=1:2" 
	States
	{
	Spawn:
		TNT1 AAAAAAAA 0 A_SpawnItemEx("NJSludgeChunk",0.1*random(-12,12),0.1*random(-12,12),16,0.1*random(-22,22),0.1*random(-22,22),0.1*random(11,77))
		NSL2 EFGH 4
		NSL2 I 5 A_SetTranslucent(0.7, 0)
		NSL2 J 5 A_SetTranslucent(0.5, 0)
		NSL2 K 5 A_SetTranslucent(0.3, 0)
		Stop
	}
}

///////////////////////////////////////////
//Water Normal
///////////////////////////////////////////
Actor NJWaterSplashChunk : LiquidParticle
{
	Alpha 0.5
	TRANSLATION "112:127=194:205"
}

Actor NJWaterSplashBase : NJCoreSplashBase
{
	Alpha 0.5
	TRANSLATION "112:119=200:207", "120:127=240:247"
	States
	{
	Spawn:
		TNT1 AAAAAAAAAA 0 A_SpawnItemEx("NJWaterSplashChunk",0.1*random(-12,12),0.1*random(-12,12),7,0.12*random(-22,22),0.12*random(-22,22),random(3,9))
		NWAT E 4 
		SPHG ABC 3
		SPHG D 3 A_SetTranslucent(0.6, 0)
		SPHG E 3 A_SetTranslucent(0.6, 0)
		NWAT K 3 A_SetTranslucent(0.5, 0)
		Stop
	}
}